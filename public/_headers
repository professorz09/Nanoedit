# Cloudflare static-asset headers (wrangler.jsonc). Same content types vercel.json sets.
/sitemap.xml
  Content-Type: application/xml; charset=utf-8

/robots.txt
  Content-Type: text/plain; charset=utf-8

# Vite's build files carry a content hash in their names — safe to cache for a year
/assets/*
  Cache-Control: public, max-age=31536000, immutable
